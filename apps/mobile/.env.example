# ===========================================================================
# Mobile app environment  (apps/mobile/.env)
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# EVERY VARIABLE HERE IS PUBLIC.
#
# Expo inlines `EXPO_PUBLIC_*` into the JavaScript bundle at build time, so
# anyone with the APK can read these values. That is fine for the two Supabase
# values below - the anon key grants no authority by itself and every table it
# can reach is behind Row Level Security.
#
# NEVER put any of these in this file or anywhere under apps/mobile:
#   - SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY
#   - the database password or any direct Postgres connection string
#   - Expo push access tokens, FCM server keys, APNs keys
#   - any third-party API secret
# Those belong to trusted server-side processes only. See docs/security.md.
# ===========================================================================

# --- Supabase (public configuration) ---------------------------------------
# Local development stack (`pnpm supabase:start` prints these):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Running on a physical device? 127.0.0.1 points at the phone, not your laptop.
# Use your machine's LAN address instead, e.g.:
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.20:54321

# --- App ---------------------------------------------------------------------
# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# debug | info | warn | error  (defaults to debug in dev, warn otherwise)
# EXPO_PUBLIC_LOG_LEVEL=debug
