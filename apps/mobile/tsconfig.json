{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    // Beyond `strict`: these are the checks that actually catch bugs in a
    // data-heavy app - indexing into a record, forgetting a `default` branch,
    // or silently ignoring an optional property.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    // With pnpm's hoisted layout every @types package lives at the workspace
    // root, so the ambient set is listed explicitly rather than discovered.
    "types": ["jest", "node"],

    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "app.config.ts"],
  "exclude": ["node_modules", "dist", ".expo", "coverage"]
}
