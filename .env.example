# ===========================================================================
# Repository-level environment  (./.env)
# ---------------------------------------------------------------------------
# For tooling that runs on YOUR machine or in CI - never for the mobile app.
# The mobile app has its own file: apps/mobile/.env.example
#
# `supabase start` generates the local keys for you; you only need the values
# below when working against a hosted Supabase project.
# ===========================================================================

# --- Supabase CLI (hosted projects only) -----------------------------------
# Project ref from the Supabase dashboard URL.
# SUPABASE_PROJECT_ID=

# Personal access token, for `supabase link` / `supabase db push` in CI.
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Database password for the linked project. Used by `supabase db push`.
# SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# The service role key is deliberately NOT listed as something to put here.
# It bypasses Row Level Security completely. Keep it in your CI secret store or
# a server-side runtime, never in a checked-out file and never in the app.
# ---------------------------------------------------------------------------

# --- EAS (mobile builds) ---------------------------------------------------
# EXPO_TOKEN=
# EAS_PROJECT_ID=
